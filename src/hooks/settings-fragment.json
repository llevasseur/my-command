{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Bash|Edit|Write|NotebookEdit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/pre-tool-use.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/stop.mjs"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(my-command-tools:*)",
      "Bash({{HOOKS_DIR}}/concept-save.mjs:*)",
      "Bash({{HOOKS_DIR}}/concept-count.mjs:*)",
      "Bash({{HOOKS_DIR}}/ideas-read.mjs:*)",
      "Bash({{HOOKS_DIR}}/ideas-add.mjs:*)",
      "Bash({{HOOKS_DIR}}/ideas-claim.mjs:*)",
      "Bash({{HOOKS_DIR}}/ideas-mark.mjs:*)",
      "Bash(~/.claude/my-command/hooks/concept-save.mjs:*)",
      "Bash(~/.claude/my-command/hooks/concept-count.mjs:*)",
      "Bash(~/.claude/my-command/hooks/ideas-read.mjs:*)",
      "Bash(~/.claude/my-command/hooks/ideas-add.mjs:*)",
      "Bash(~/.claude/my-command/hooks/ideas-claim.mjs:*)",
      "Bash(~/.claude/my-command/hooks/ideas-mark.mjs:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git merge-base:*)",
      "Bash(git symbolic-ref:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-remote:*)",
      "Bash(git ls-tree:*)",
      "Bash(git for-each-ref:*)",
      "Bash(git check-ignore:*)",
      "Bash(git describe:*)",
      "Bash(git blame:*)",
      "Bash(git shortlog:*)",
      "Bash(git branch --show-current)",
      "Bash(git worktree list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh repo view:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh auth status:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(jq:*)",
      "Bash(okq:*)",
      "Bash(readlink:*)",
      "Bash(realpath:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)"
    ]
  }
}
